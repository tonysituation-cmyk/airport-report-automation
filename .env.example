# Copy to .env and edit. All variables are optional.

# Data sources
# OPS_API_URL=https://ops.internal.example.com/api/v1/events
# OPS_API_TIMEOUT=10
# OPS_API_RETRIES=3
# OPS_SQLITE_DB=./data/flights.db
# OPS_EXCEL_SOURCE=./data/passenger_stats.xlsx
# OPS_API_SNAPSHOT=./data/ops_api_snapshot.json

# Alerting
# OPS_DELAY_RATE_THRESHOLD=0.20
# OPS_MIN_PASSENGERS=8000
# OPS_ALERT_EMAIL=oncall@example.com
# OPS_SMTP_HOST=smtp.example.com
# OPS_SMTP_PORT=465
# OPS_SMTP_USER=alerts@example.com
# OPS_SMTP_PASSWORD=changeme

# Logging
# OPS_LOG_LEVEL=INFO
